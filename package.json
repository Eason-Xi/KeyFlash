    "react": "19.3.0",
    "react-dom": "19.3.0",
    "spark-md5": "3.0.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spark-md5": "3.0.5",
    "@types/w3c-web-serial": "1.0.8",
    "prettier": "3.9.9",
